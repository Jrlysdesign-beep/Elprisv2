{
  "name": "elpris-push-isolated-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elpris-push-isolated-test-db",
      "database_id": "2811e53d-ee9d-45d2-94dc-d8ffed33d447"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://jrlysdesign-beep.github.io",
    "PRICE_URL": "https://jrlysdesign-beep.github.io/Elprisv2/prices.json",
    "ENABLE_AUTOMATIC_PRICE_PUSH": "true"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
